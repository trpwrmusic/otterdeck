{
  "name": "otterdeck",
  "version": "0.2.0",
  "description": "Ein Zuhause für deine Claude-Code-Sitzungen, unter Windows und Linux",
  "scripts": {
    "dev": "concurrently -k -n server,web -c auto \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --import tsx --watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node bin/otter.mjs",
    "server": "node --import tsx server/index.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "type": "module",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.69.0",
    "marked": "^18.1.3",
    "node-pty": "^1.1.0",
    "qrcode-generator": "^1.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "private": true,
  "bin": {
    "otter": "bin/otter.mjs"
  },
  "optionalDependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1"
  }
}
